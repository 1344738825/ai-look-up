    { "cmd": "cd /d && python _peek2.py", "want": "python _peek.py" },
    { "cmd": "grep -rn \"foo\" a.txt", "want": "grep -rn \"foo\" a.txt" },
    { "cmd": "git checkout main", "want": "git checkout main" },
    { "cmd": "npm run build2", "want": "npm run build2" },
    { "cmd": "pip install numpy", "want": "pip install numpy" },
    { "cmd": "cat a.txt | grep foo", "want": "cat a.txt | grep foo" },
    { "cmd": "curl https://a.com/x", "want": "curl https://a.com/x" },
    { "cmd": "git status", "want": "git status" },
    { "cmd": "", "want": "" }
  ],
